AUTH_SECRET=change-me-to-a-long-random-string-in-production
NEXT_PUBLIC_SITE_URL=https://www.delegis.be
# Search Console / Bing Webmaster verification tokens (optional)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Demo account (button on /login). Set DEMO_ENABLED=false before launch.
DEMO_ENABLED=true
# Optional: lets you also sign in to demo@delegis.test with a password
DEMO_PASSWORD=demo-delegis-2026

# Production (Vercel): Neon Postgres and Vercel Blob. Leave empty locally to use PGlite + ./data/uploads.
DATABASE_URL=
BLOB_READ_WRITE_TOKEN=
