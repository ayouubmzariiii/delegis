AUTH_SECRET=change-me-to-a-long-random-string-in-production
# Optional: separate key for encrypting shared access passwords (defaults to one derived from AUTH_SECRET).
# Set it once and never change it, or stored passwords can no longer be decrypted.
ACCESS_ENCRYPTION_KEY=
NEXT_PUBLIC_SITE_URL=https://www.delegis.be
# Search Console / Bing Webmaster verification tokens (optional)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Demo accounts (buttons on /login). Off in production unless set to true: the demo team account
# opens the back-office, so never turn it on once real clients use the site.
DEMO_ENABLED=
# Optional: lets you also sign in to demo@delegis.test with a password
DEMO_PASSWORD=demo-delegis-2026

# Production (Vercel): Neon Postgres and Vercel Blob. Leave empty locally to use PGlite + ./data/uploads.
DATABASE_URL=
BLOB_READ_WRITE_TOKEN=

# Optional: e-mail each contact request (requests are always listed in Admin → Demandes).
RESEND_API_KEY=
LEAD_NOTIFY_EMAIL=
# Sender; leave empty to use Resend's shared sender (only delivers to your Resend account's address).
LEAD_FROM_EMAIL=
